{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "accaforge",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "accaforge",
      "database_id": "e38a3c55-da2f-4c19-8ba4-adccab36dd92",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
